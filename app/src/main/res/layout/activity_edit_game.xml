<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingTop="130dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modificar Videojuego"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etEditarTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Título del juego"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditarPlataforma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Plataforma"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEditarEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Estado (ej: Jugando, Completado)"
        android:inputType="text"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnGuardarCambios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Cambios"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnEliminarJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar Juego"
        android:backgroundTint="#D32F2F"
        android:layout_marginBottom="12dp"/>


    <Button
        android:id="@+id/btnVolverEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar / Volver"
        android:backgroundTint="#757575"/>

</LinearLayout>
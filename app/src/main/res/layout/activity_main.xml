<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">


    <ImageView
        android:id="@+id/ivLogoPrincipal"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_app"
        android:contentDescription="Logo de la aplicación"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BDGames Victor"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnIrAgregar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Agregar Juego"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrListado"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Ver Lista de Juegos"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrModificar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Modificar Juegos"
        android:textSize="16sp"/>

</LinearLayout>